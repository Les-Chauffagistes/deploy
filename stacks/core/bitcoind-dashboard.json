{
  "uid": "bitcoind",
  "title": "Bitcoind (debian)",
  "tags": ["bitcoin", "debian"],
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 1,
  "refresh": "30s",
  "time": { "from": "now-6h", "to": "now" },
  "panels": [
    { "id": 1, "type": "row", "title": "État", "gridPos": { "h": 1, "w": 24, "x": 0, "y": 0 } },
    {
      "id": 2,
      "type": "stat",
      "title": "Service bitcoind",
      "gridPos": { "h": 4, "w": 6, "x": 0, "y": 1 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        { "expr": "node_systemd_unit_state{name=\"bitcoind.service\", state=\"active\"}", "legendFormat": "actif" }
      ],
      "fieldConfig": {
        "defaults": {
          "mappings": [
            { "type": "value", "options": { "0": { "text": "Arrêté / échec" }, "1": { "text": "Actif" } } }
          ],
          "thresholds": { "mode": "absolute", "steps": [{ "color": "red", "value": null }, { "color": "green", "value": 1 }] }
        }
      },
      "options": { "colorMode": "background", "graphMode": "none", "reduceOptions": { "calcs": ["lastNotNull"] } }
    },

    { "id": 30, "type": "row", "title": "Synchronisation", "gridPos": { "h": 1, "w": 24, "x": 0, "y": 5 } },
    {
      "id": 31,
      "type": "stat",
      "title": "Bloc courant",
      "description": "Hauteur extraite de la dernière ligne UpdateTip (journal systemd de bitcoind) — pas de RPC exposé côté monitoring, la source est le log.",
      "gridPos": { "h": 4, "w": 6, "x": 0, "y": 6 },
      "datasource": { "type": "loki", "uid": "loki" },
      "targets": [
        { "expr": "last_over_time({job=\"systemd-journal\", unit=\"bitcoind.service\"} |= \"UpdateTip\" | regexp `height=(?P<height>\\d+)` | unwrap height [$__range])", "legendFormat": "height" }
      ],
      "fieldConfig": { "defaults": { "unit": "none", "decimals": 0 } },
      "options": { "colorMode": "none", "graphMode": "none", "reduceOptions": { "calcs": ["lastNotNull"] } }
    },
    {
      "id": 32,
      "type": "stat",
      "title": "Progression de synchro",
      "description": "verificationprogress extrait de la dernière ligne UpdateTip. Peut légèrement dépasser l'avancement réel en toute fin de synchro (l'estimation du log utilise le temps entre blocs, pas la hauteur du tip réseau).",
      "gridPos": { "h": 4, "w": 6, "x": 6, "y": 6 },
      "datasource": { "type": "loki", "uid": "loki" },
      "targets": [
        { "expr": "last_over_time({job=\"systemd-journal\", unit=\"bitcoind.service\"} |= \"UpdateTip\" | regexp `progress=(?P<progress>[0-9.]+)` | unwrap progress [$__range])", "legendFormat": "progress" }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "min": 0,
          "max": 1,
          "decimals": 2,
          "thresholds": { "mode": "absolute", "steps": [{ "color": "orange", "value": null }, { "color": "green", "value": 0.999 }] }
        }
      },
      "options": { "colorMode": "background", "graphMode": "none", "reduceOptions": { "calcs": ["lastNotNull"] } }
    },

    { "id": 10, "type": "row", "title": "Stockage (/mnt/bitcoin)", "gridPos": { "h": 1, "w": 24, "x": 0, "y": 10 } },
    {
      "id": 11,
      "type": "bargauge",
      "title": "Espace disque disponible (%)",
      "description": "Disque externe de la blockchain. Seuils alignés sur l'alerte BitcoindDiskSpaceLow (< 10%). Une barre absente signifie que le point de montage /mnt/bitcoin n'est pas vu par node-exporter (voir BitcoindDiskNotMounted).",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 11 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        { "expr": "node_filesystem_avail_bytes{node=\"debian\", mountpoint=\"/mnt/bitcoin\"} / node_filesystem_size_bytes{node=\"debian\", mountpoint=\"/mnt/bitcoin\"}", "legendFormat": "libre" }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "min": 0,
          "max": 1,
          "thresholds": { "mode": "absolute", "steps": [{ "color": "red", "value": null }, { "color": "orange", "value": 0.1 }, { "color": "green", "value": 0.2 }] }
        }
      },
      "options": { "orientation": "horizontal", "displayMode": "gradient" }
    },
    {
      "id": 12,
      "type": "timeseries",
      "title": "Espace disque",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 11 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        { "expr": "node_filesystem_avail_bytes{node=\"debian\", mountpoint=\"/mnt/bitcoin\"}", "legendFormat": "disponible" },
        { "expr": "node_filesystem_size_bytes{node=\"debian\", mountpoint=\"/mnt/bitcoin\"}", "legendFormat": "total" }
      ],
      "fieldConfig": { "defaults": { "unit": "bytes" } }
    },

    { "id": 20, "type": "row", "title": "Logs", "gridPos": { "h": 1, "w": 24, "x": 0, "y": 19 } },
    {
      "id": 21,
      "type": "logs",
      "title": "Logs bitcoind (journal systemd)",
      "gridPos": { "h": 10, "w": 24, "x": 0, "y": 20 },
      "datasource": { "type": "loki", "uid": "loki" },
      "targets": [{ "expr": "{job=\"systemd-journal\", unit=\"bitcoind.service\"}" }],
      "options": { "showTime": true, "sortOrder": "Descending", "wrapLogMessage": true, "enableLogDetails": true }
    }
  ]
}
