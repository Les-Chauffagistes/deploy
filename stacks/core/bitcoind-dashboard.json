{
  "uid": "bitcoind",
  "title": "Bitcoind (debian)",
  "tags": ["bitcoin", "debian"],
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 1,
  "refresh": "30s",
  "time": { "from": "now-6h", "to": "now" },
  "panels": [
    { "id": 1, "type": "row", "title": "État", "gridPos": { "h": 1, "w": 24, "x": 0, "y": 0 } },
    {
      "id": 2,
      "type": "stat",
      "title": "Service bitcoind",
      "gridPos": { "h": 4, "w": 6, "x": 0, "y": 1 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        { "expr": "node_systemd_unit_state{name=\"bitcoind.service\", state=\"active\"}", "legendFormat": "actif" }
      ],
      "fieldConfig": {
        "defaults": {
          "mappings": [
            { "type": "value", "options": { "0": { "text": "Arrêté / échec" }, "1": { "text": "Actif" } } }
          ],
          "thresholds": { "mode": "absolute", "steps": [{ "color": "red", "value": null }, { "color": "green", "value": 1 }] }
        }
      },
      "options": { "colorMode": "background", "graphMode": "none", "reduceOptions": { "calcs": ["lastNotNull"] } }
    },

    { "id": 10, "type": "row", "title": "Stockage (/mnt/bitcoin)", "gridPos": { "h": 1, "w": 24, "x": 0, "y": 5 } },
    {
      "id": 11,
      "type": "bargauge",
      "title": "Espace disque disponible (%)",
      "description": "Disque externe de la blockchain. Seuils alignés sur l'alerte BitcoindDiskSpaceLow (< 10%). Une barre absente signifie que le point de montage /mnt/bitcoin n'est pas vu par node-exporter (voir BitcoindDiskNotMounted).",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 6 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        { "expr": "node_filesystem_avail_bytes{node=\"debian\", mountpoint=\"/mnt/bitcoin\"} / node_filesystem_size_bytes{node=\"debian\", mountpoint=\"/mnt/bitcoin\"}", "legendFormat": "libre" }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "min": 0,
          "max": 1,
          "thresholds": { "mode": "absolute", "steps": [{ "color": "red", "value": null }, { "color": "orange", "value": 0.1 }, { "color": "green", "value": 0.2 }] }
        }
      },
      "options": { "orientation": "horizontal", "displayMode": "gradient" }
    },
    {
      "id": 12,
      "type": "timeseries",
      "title": "Espace disque",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 6 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        { "expr": "node_filesystem_avail_bytes{node=\"debian\", mountpoint=\"/mnt/bitcoin\"}", "legendFormat": "disponible" },
        { "expr": "node_filesystem_size_bytes{node=\"debian\", mountpoint=\"/mnt/bitcoin\"}", "legendFormat": "total" }
      ],
      "fieldConfig": { "defaults": { "unit": "bytes" } }
    },

    { "id": 20, "type": "row", "title": "Logs", "gridPos": { "h": 1, "w": 24, "x": 0, "y": 14 } },
    {
      "id": 21,
      "type": "logs",
      "title": "Logs bitcoind (journal systemd)",
      "gridPos": { "h": 10, "w": 24, "x": 0, "y": 15 },
      "datasource": { "type": "loki", "uid": "loki" },
      "targets": [{ "expr": "{job=\"systemd-journal\", unit=\"bitcoind.service\"}" }],
      "options": { "showTime": true, "sortOrder": "Descending", "wrapLogMessage": true, "enableLogDetails": true }
    }
  ]
}
