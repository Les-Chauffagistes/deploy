{
  "uid": "bitcoind",
  "title": "Bitcoind",
  "tags": ["bitcoin"],
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 1,
  "refresh": "30s",
  "time": { "from": "now-6h", "to": "now" },
  "templating": {
    "list": [
      {
        "name": "node",
        "label": "Node (logs)",
        "type": "query",
        "datasource": { "type": "prometheus", "uid": "prometheus" },
        "query": { "query": "label_values(node_systemd_unit_state{name=\"bitcoind.service\"}, node)", "refId": "node" },
        "refresh": 2,
        "multi": true,
        "includeAll": true,
        "current": { "selected": true, "text": "All", "value": "$__all" }
      }
    ]
  },
  "panels": [
    { "id": 1, "type": "row", "title": "État", "gridPos": { "h": 1, "w": 24, "x": 0, "y": 0 } },
    {
      "id": 2,
      "type": "stat",
      "title": "Service bitcoind",
      "gridPos": { "h": 4, "w": 6, "x": 0, "y": 1 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        { "expr": "node_systemd_unit_state{name=\"bitcoind.service\", state=\"active\"}", "legendFormat": "{{node}}" }
      ],
      "fieldConfig": {
        "defaults": {
          "mappings": [
            { "type": "value", "options": { "0": { "text": "Arrêté / échec" }, "1": { "text": "Actif" } } }
          ],
          "thresholds": { "mode": "absolute", "steps": [{ "color": "red", "value": null }, { "color": "green", "value": 1 }] }
        }
      },
      "options": { "colorMode": "background", "graphMode": "none", "reduceOptions": { "calcs": ["lastNotNull"] }, "textMode": "value_and_name" }
    },
    {
      "id": 3,
      "type": "stat",
      "title": "Pairs connectés (P2P)",
      "description": "Via bitcoind-exporter (stacks/core/bitcoind-exporter.yml), qui interroge le RPC de bitcoind (getpeerinfo/getnetworkinfo).",
      "gridPos": { "h": 4, "w": 6, "x": 6, "y": 1 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        { "expr": "bitcoin_conn_in", "legendFormat": "{{node}} · in" },
        { "expr": "bitcoin_conn_out", "legendFormat": "{{node}} · out" }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "none",
          "decimals": 0,
          "thresholds": { "mode": "absolute", "steps": [{ "color": "red", "value": null }, { "color": "orange", "value": 1 }, { "color": "green", "value": 4 }] }
        }
      },
      "options": { "colorMode": "background", "graphMode": "none", "reduceOptions": { "calcs": ["lastNotNull"] }, "textMode": "value_and_name", "orientation": "horizontal" }
    },

    { "id": 30, "type": "row", "title": "Synchronisation", "gridPos": { "h": 1, "w": 24, "x": 0, "y": 5 } },
    {
      "id": 31,
      "type": "stat",
      "title": "Bloc courant",
      "description": "Via bitcoind-exporter (getblockchaininfo).",
      "gridPos": { "h": 4, "w": 6, "x": 0, "y": 6 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        { "expr": "bitcoin_blocks", "legendFormat": "{{node}}" }
      ],
      "fieldConfig": { "defaults": { "unit": "none", "decimals": 0 } },
      "options": { "colorMode": "none", "graphMode": "none", "reduceOptions": { "calcs": ["lastNotNull"] }, "textMode": "value_and_name" }
    },
    {
      "id": 32,
      "type": "stat",
      "title": "Progression de synchro",
      "description": "Via bitcoind-exporter (getblockchaininfo.verificationprogress).",
      "gridPos": { "h": 4, "w": 6, "x": 6, "y": 6 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        { "expr": "bitcoin_verification_progress", "legendFormat": "{{node}}" }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "min": 0,
          "max": 1,
          "decimals": 2,
          "thresholds": { "mode": "absolute", "steps": [{ "color": "orange", "value": null }, { "color": "green", "value": 0.999 }] }
        }
      },
      "options": { "colorMode": "background", "graphMode": "none", "reduceOptions": { "calcs": ["lastNotNull"] }, "textMode": "value_and_name" }
    },

    { "id": 10, "type": "row", "title": "Stockage (/mnt/bitcoin)", "gridPos": { "h": 1, "w": 24, "x": 0, "y": 10 } },
    {
      "id": 11,
      "type": "bargauge",
      "title": "Espace disque disponible (%)",
      "description": "Une barre par node ayant /mnt/bitcoin. Disque externe de la blockchain. Seuils alignés sur l'alerte BitcoindDiskSpaceLow (< 10%). Une barre absente signifie que le point de montage /mnt/bitcoin n'est pas vu par node-exporter (voir BitcoindDiskNotMounted).",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 11 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        { "expr": "node_filesystem_avail_bytes{mountpoint=\"/mnt/bitcoin\"} / node_filesystem_size_bytes{mountpoint=\"/mnt/bitcoin\"}", "legendFormat": "{{node}}" }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "min": 0,
          "max": 1,
          "thresholds": { "mode": "absolute", "steps": [{ "color": "red", "value": null }, { "color": "orange", "value": 0.1 }, { "color": "green", "value": 0.2 }] }
        }
      },
      "options": { "orientation": "horizontal", "displayMode": "gradient" }
    },
    {
      "id": 12,
      "type": "timeseries",
      "title": "Espace disque",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 11 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        { "expr": "node_filesystem_avail_bytes{mountpoint=\"/mnt/bitcoin\"}", "legendFormat": "{{node}} · disponible" },
        { "expr": "node_filesystem_size_bytes{mountpoint=\"/mnt/bitcoin\"}", "legendFormat": "{{node}} · total" }
      ],
      "fieldConfig": { "defaults": { "unit": "bytes" } }
    },

    { "id": 20, "type": "row", "title": "Logs", "gridPos": { "h": 1, "w": 24, "x": 0, "y": 19 } },
    {
      "id": 21,
      "type": "logs",
      "title": "Logs bitcoind (journal systemd) — filtrés par $node",
      "gridPos": { "h": 10, "w": 24, "x": 0, "y": 20 },
      "datasource": { "type": "loki", "uid": "loki" },
      "targets": [{ "expr": "{job=\"systemd-journal\", unit=\"bitcoind.service\", node=~\"$node\"}" }],
      "options": { "showTime": true, "sortOrder": "Descending", "wrapLogMessage": true, "enableLogDetails": true }
    }
  ]
}
